{
  "info": {
    "_postman_id": "expense-tracker-collection-v1",
    "name": "Expense Tracker API",
    "description": "MERN Expense Tracker – test all CRUD endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET all expenses",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5001/api/expenses",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "expenses"]
        },
        "description": "Returns all expenses sorted by date (newest first)."
      }
    },
    {
      "name": "POST create expense",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Lunch at canteen\",\n  \"amount\": 150,\n  \"category\": \"Food\"\n}"
        },
        "url": {
          "raw": "http://localhost:5001/api/expenses",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "expenses"]
        },
        "description": "Creates a new expense. Returns 201 on success."
      }
    },
    {
      "name": "POST invalid expense (missing title)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 50,\n  \"category\": \"Transport\"\n}"
        },
        "url": {
          "raw": "http://localhost:5001/api/expenses",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "expenses"]
        },
        "description": "Should return 400 Bad Request because 'title' is required."
      }
    },
    {
      "name": "PUT update expense",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated title\",\n  \"amount\": 200,\n  \"category\": \"Study\"\n}"
        },
        "url": {
          "raw": "http://localhost:5001/api/expenses/REPLACE_WITH_REAL_ID",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "expenses", "REPLACE_WITH_REAL_ID"]
        },
        "description": "Updates an expense. Replace REPLACE_WITH_REAL_ID with an actual MongoDB _id from the GET response."
      }
    },
    {
      "name": "DELETE expense",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:5001/api/expenses/REPLACE_WITH_REAL_ID",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "expenses", "REPLACE_WITH_REAL_ID"]
        },
        "description": "Deletes an expense by ID. Returns 404 if not found."
      }
    }
  ]
}
